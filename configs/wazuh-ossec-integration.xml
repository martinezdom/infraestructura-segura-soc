<!--
  Configuracion de integracion en /var/ossec/etc/ossec.conf
  Permite remitir alertas de severidad >= 3 directamente al webhook de n8n
-->
<ossec_config>
  <integration>
    <name>custom-n8n.py</name>
    <hook_url>http://10.3.100.11:5678/webhook-test/wazuh-alerts</hook_url>
    <level>3</level>
    <alert_format>json</alert_format>
  </integration>

  <!-- Integracion con VirusTotal para analisis automatico de hashes generados por FIM -->
  <integration>
    <name>virustotal</name>
    <api_key>API_KEY_DE_VIRUSTOTAL</api_key>
    <group>syscheck</group>
    <alert_format>json</alert_format>
  </integration>

  <!-- Configuracion de monitorizacion de integridad de archivos (FIM) en Windows Agent -->
  <syscheck>
    <directories check_all="yes" realtime="yes" report_changes="yes">C:\Users\*\Desktop</directories>
    <directories check_all="yes" realtime="yes">C:\Seguretatbatoi</directories>
    <nodiff>C:\Windows\System32\winevt\Logs</nodiff>
    <frequency>300</frequency>
  </syscheck>
</ossec_config>
