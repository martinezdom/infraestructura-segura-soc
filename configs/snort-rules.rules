# Reglas personalizadas de deteccion para Snort IDS
# Ubicacion: /etc/snort/rules/local.rules

# 1. Deteccion de escaneo ICMP (mas de 10 peticiones echo en 60 segundos)
alert icmp any any -> any any (msg:"[Custom] Posible escaneo ICMP (>=10 echo request/min)"; itype:8; threshold:type both, track by_src, count 10, seconds 60; sid:1000001; rev:1;)

# 2. Deteccion de inundacion ICMP / DoS (mas de 100 paquetes en 3 segundos)
alert icmp any any -> any any (msg:"[Custom] ICMP Flood Detected"; itype:8; threshold:type both, track by_src, count 100, seconds 3; sid:1000002; rev:1;)

# 3. Deteccion de escaneo de puertos SYN (Nmap SYN scan)
alert tcp any any -> any any (msg:"[Custom] Posible escaneo de puertos SYN (Nmap)"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000003; rev:1;)

# 4. Deteccion de intentos de Path Traversal sobre HTTP
alert tcp any any -> any 80 (msg:"[Custom] Intento de Path Traversal detectado"; content:"../"; nocase; sid:1000004; rev:1;)

# 5. Deteccion de fuerza bruta sobre el servicio SSH
alert tcp any any -> any 22 (msg:"[Custom] Multiples intentos de conexion SSH"; flags:S; threshold:type both, track by_src, count 5, seconds 30; sid:1000005; rev:1;)
